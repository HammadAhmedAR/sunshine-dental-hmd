<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<a class="skip-link" href="#main-content">Skip to content</a>
<aside class="sidebar" aria-label="Clinic navigation">
    <a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark" aria-hidden="true">S+</span><span>sunrise<small>DENTAL CLINIC</small></span></a>
    <p class="nav-label">WORKSPACE</p>
    <nav>
        <c:choose>
            <c:when test="${not empty sessionScope.loggedUser}">
                <a class="nav-item ${activePage == 'dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}/dashboard">Dashboard</a>
                <a class="nav-item ${activePage == 'appointments' ? 'active' : ''}" href="${pageContext.request.contextPath}/appointments">Appointments</a>
                <a class="nav-item ${activePage == 'new' ? 'active' : ''}" href="${pageContext.request.contextPath}/appointments/new">New Appointment</a>
            </c:when>
            <c:otherwise><a class="nav-item active" href="${pageContext.request.contextPath}/login">Staff sign-in</a></c:otherwise>
        </c:choose>
        <c:if test="${not empty sessionScope.loggedUser}">
            <a class="nav-item ${activePage == 'billing' ? 'active' : ''}" href="${pageContext.request.contextPath}/billing">Billing</a>
            <a class="nav-item ${activePage == 'reports' ? 'active' : ''}" href="${pageContext.request.contextPath}/reports">Reports</a>
            <a class="nav-item ${activePage == 'help' ? 'active' : ''}" href="${pageContext.request.contextPath}/help">Help</a>
            <form method="post" action="${pageContext.request.contextPath}/logout">
                <input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}">
                <button class="nav-item logout-button" type="submit">Logout</button>
            </form>
        </c:if>
    </nav>
    <div class="sidebar-note"><span class="status-dot" aria-hidden="true"></span> Sunrise staff workspace<small>Thoughtful care. Organised days.</small></div>
</aside>
